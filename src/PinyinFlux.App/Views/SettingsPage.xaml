<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PinyinFlux.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PinyinFlux.App.Controls"
    xmlns:services="using:PinyinFlux.App.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,8,32,32" Spacing="16">

            <!-- General -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="常规" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="开机自动启动" Description="只启动后台核心。若注入需要管理员权限，登录后仍需在概览中点击“提权重启”；此开关不会绕过 UAC。">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Query -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="查询" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="保留本地首选，云端有本地没有的词时才进入原生第 2 位；等待、无结果、超时或与本地重复时候选不变。至少 4 个字母才查询，支持简拼与混拼。" TextWrapping="Wrap" Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                    <controls:SettingRow Header="超时" Description="来源超过此时间会被跳过；原生候选最多等待 450 毫秒，迟到的结果回填缓存供下次使用。成功结果缓存 30 分钟，部分失败只缓存 60 秒。">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="{StaticResource RowSliderWidth}" Minimum="300" Maximum="3000" StepFrequency="100" VerticalAlignment="Center"
                                    Value="{x:Bind ViewModel.TimeoutMs, Mode=TwoWay}" />
                            <TextBlock MinWidth="56" VerticalAlignment="Center" Text="{x:Bind services:Ui.Milliseconds(ViewModel.TimeoutMs), Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingRow>
                    <controls:SettingRow Header="最多候选数" Description="旧代理模式与诊断查询返回的云候选个数。原生模式自动决定：最可信的一个，加上两个词库都排在前两名的词，最多 3 个。">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="{StaticResource RowSliderWidth}" Minimum="1" Maximum="8" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight"
                                    VerticalAlignment="Center" Value="{x:Bind ViewModel.MaxCandidates, Mode=TwoWay}" />
                            <TextBlock MinWidth="56" VerticalAlignment="Center" Text="{x:Bind services:Ui.Number(ViewModel.MaxCandidates), Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Interception -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="拦截" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="原生注入（实验）" Description="主动触发微软原生云候选，不使用独立候选窗。首次运行按本机 Windows 版本下载微软公开符号自动适配，可能需要管理员权限。切换后需重新启动核心；关闭则使用旧代理模式。">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.NativeInjection, Mode=TwoWay}" />
                    </controls:SettingRow>
                    <controls:SettingRow Header="只解密微软拼音的连接"
                                         Description="仅旧代理模式有效。浏览器等其他程序访问 Bing 的流量原样加密转发。">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.ImeOnly, Mode=TwoWay}" />
                    </controls:SettingRow>
                    <controls:SettingRow Header="代理设置被改写时重新接管"
                                         Description="仅旧代理模式有效。其他代理工具改写系统代理后重新应用 PAC，10 分钟内最多 3 次。">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.ReclaimProxy, Mode=TwoWay}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="诊断" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="写入日志" Description="记录每次云查询（包含输入的拼音）到 core.log，最大 2 MB。排查问题时再开。">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.LogToFile, Mode=TwoWay}" />
                    </controls:SettingRow>
                    <controls:SettingRow Header="数据目录" Description="配置、日志和代理设置备份。">
                        <Button Content="打开文件夹" Command="{x:Bind ViewModel.OpenDataFolderCommand}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Revert -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="停用" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="撤销 PinyinFlux 对系统的所有改动"
                                         Description="停止核心，恢复原来的代理设置，删除本地证书及私钥，取消开机启动。程序本身仍保留，可随时在“概览”重新启用；要彻底删除请在“Windows 设置 → 应用”中卸载，卸载程序会自动完成同样的还原。">
                        <Button Content="停用并还原" Command="{x:Bind Status.UninstallCommand}" />
                    </controls:SettingRow>
                    <TextBlock Text="{x:Bind Status.Message, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{x:Bind services:Ui.VisibleIfText(Status.Message), Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
