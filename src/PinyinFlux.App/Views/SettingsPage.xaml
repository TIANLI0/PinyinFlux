<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PinyinFlux.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PinyinFlux.App.Controls"
    xmlns:services="using:PinyinFlux.App.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,8,32,32" Spacing="16">

            <!-- General -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="常规" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="开机自动启动" Description="登录 Windows 后在后台运行，不显示窗口。授予过一次管理员权限后，开机启动不会再弹出确认。">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Microsoft Pinyin's own settings that matter here -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="微软拼音" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="云候选" Description="{x:Bind CloudSwitchText(Status.PinyinCloudEnabled), Mode=OneWay}">
                        <Button Content="打开" Command="{x:Bind Status.EnableCloudCandidatesCommand}"
                                Visibility="{x:Bind ShowEnableCloud(Status.PinyinCloudEnabled), Mode=OneWay}" />
                    </controls:SettingRow>
                    <controls:SettingRow Header="微软拼音设置" Description="模糊音、快捷键、候选个数、自学习词库等由微软拼音管理，PinyinFlux 不会改动。">
                        <Button Content="打开" Click="OnOpenPinyinSettings" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Query -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="云词" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                   Text="输入 4 个及以上字母后查询，支持全拼、简拼（yyds）和混拼（yuanshenqd）。微软拼音的第 1 位始终保留，本地没有的云词放在第 2 位，最多 3 个。" />
                    </StackPanel>
                    <controls:SettingRow Header="云词库响应时限" Description="某个云词库超过这个时间没回应就先跳过，它的结果留到下次输入同样的拼音时使用。网络较慢时可调高。">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Width="{StaticResource RowSliderWidth}" Minimum="300" Maximum="3000" StepFrequency="100" VerticalAlignment="Center"
                                    Value="{x:Bind ViewModel.TimeoutMs, Mode=TwoWay}" />
                            <TextBlock MinWidth="56" VerticalAlignment="Center" Text="{x:Bind services:Ui.Milliseconds(ViewModel.TimeoutMs), Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="更新" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="{x:Bind Updates.VersionHeader}" Description="{x:Bind Updates.StatusText, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind Updates.ActionText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind services:Ui.Visible(Updates.IsActionVisible), Mode=OneWay}"
                                    Command="{x:Bind Updates.RunActionCommand}" />
                            <Button Content="检查更新" Command="{x:Bind Updates.CheckCommand}" />
                        </StackPanel>
                    </controls:SettingRow>
                    <ProgressBar Value="{x:Bind Updates.Progress, Mode=OneWay}" Maximum="100"
                                 Visibility="{x:Bind services:Ui.Visible(Updates.IsDownloading), Mode=OneWay}" />
                    <Expander Header="更新内容" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Visibility="{x:Bind services:Ui.Visible(Updates.HasReleaseNotes), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind Updates.ReleaseNotes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <HyperlinkButton Content="在 GitHub 上查看" NavigateUri="{x:Bind Updates.ReleaseNotesUrl, Mode=OneWay}" Padding="0" />
                        </StackPanel>
                    </Expander>
                    <controls:SettingRow Header="自动检查并下载更新" Description="打开 PinyinFlux 时检查新版本，在后台下载并校验；安装前会先询问。">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.AutoUpdate, Mode=TwoWay}" />
                    </controls:SettingRow>
                    <controls:SettingRow Header="接收预览版" Description="提前体验新功能，但可能不太稳定。">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.IncludePrerelease, Mode=TwoWay}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Connection mode -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="高级" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="接入方式" Description="{x:Bind ViewModel.ConnectionModeDescription, Mode=OneWay}">
                        <ComboBox MinWidth="180" SelectedIndex="{x:Bind ViewModel.ConnectionMode, Mode=TwoWay}">
                            <x:String>直接接入（推荐）</x:String>
                            <x:String>兼容模式</x:String>
                        </ComboBox>
                    </controls:SettingRow>
                    <TextBlock Text="{x:Bind Status.ModeMessage, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{x:Bind services:Ui.VisibleIfText(Status.ModeMessage), Mode=OneWay}" />
                    <StackPanel Spacing="12" Visibility="{x:Bind services:Ui.Visible(ViewModel.IsCompatibilityMode), Mode=OneWay}">
                        <controls:SettingRow Header="云词个数" Description="每次给微软拼音的云词个数。">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider Width="{StaticResource RowSliderWidth}" Minimum="1" Maximum="8" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight"
                                        VerticalAlignment="Center" Value="{x:Bind ViewModel.MaxCandidates, Mode=TwoWay}" />
                                <TextBlock MinWidth="56" VerticalAlignment="Center" Text="{x:Bind services:Ui.Number(ViewModel.MaxCandidates), Mode=OneWay}" />
                            </StackPanel>
                        </controls:SettingRow>
                        <controls:SettingRow Header="只处理微软拼音的连接" Description="浏览器等其他程序访问 Bing 时原样转发，不经证书解密。">
                            <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.ImeOnly, Mode=TwoWay}" />
                        </controls:SettingRow>
                        <controls:SettingRow Header="代理被其他软件改写时自动恢复" Description="其他代理软件改写系统代理后重新指向 PinyinFlux，10 分钟内最多 3 次，避免和它们来回争抢。">
                            <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.ReclaimProxy, Mode=TwoWay}" />
                        </controls:SettingRow>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="诊断" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="复制诊断信息" Description="版本、微软拼音设置和后台运行状态，反馈问题时附上即可。">
                        <Button Content="复制" Command="{x:Bind Status.CopyDiagnosticsCommand}" />
                    </controls:SettingRow>
                    <TextBlock Text="{x:Bind Status.DiagnosticsMessage, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{x:Bind services:Ui.VisibleIfText(Status.DiagnosticsMessage), Mode=OneWay}" />
                    <controls:SettingRow Header="写入日志" Description="把每次查询（包含输入的拼音）记录到 core.log，最大 2 MB。仅在排查问题时打开。">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind ViewModel.LogToFile, Mode=TwoWay}" />
                    </controls:SettingRow>
                    <controls:SettingRow Header="数据文件夹" Description="设置、日志和系统代理的备份。">
                        <Button Content="打开" Command="{x:Bind ViewModel.OpenDataFolderCommand}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Revert -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="停用" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:SettingRow Header="撤销 PinyinFlux 对系统的所有改动"
                                         Description="停止后台运行，取消开机启动，并删除兼容模式用过的证书、恢复系统代理。程序本身保留，可随时在“概览”中重新启用；在“Windows 设置 → 应用”中卸载也会自动完成同样的还原。">
                        <Button Content="停用并还原" Command="{x:Bind Status.UninstallCommand}" />
                    </controls:SettingRow>
                    <TextBlock Text="{x:Bind Status.Message, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{x:Bind services:Ui.VisibleIfText(Status.Message), Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
