<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PinyinFlux.App.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PinyinFlux.App.Controls"
    xmlns:services="using:PinyinFlux.App.Services"
    xmlns:vm="using:PinyinFlux.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="32,8,32,32" Spacing="16">

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="打字统计已关闭"
                     Message="不会记录新的数据，已有的记录保留。"
                     Visibility="{x:Bind services:Ui.Collapsed(Settings.TypingStats), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="打开" Click="OnEnable" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="兼容模式下不统计"
                     Message="在“设置 → 高级”中改用“直接接入”后开始记录。"
                     Visibility="{x:Bind services:Ui.Visible(ViewModel.IsCompatibilityMode), Mode=OneWay}" />

            <!-- Today -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="今天" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="上屏汉字" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Chars, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" ToolTipService.ToolTip="停顿超过 30 秒不计入">
                            <TextBlock Text="打字时长" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Time, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="速度" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Speed, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="2" ToolTipService.ToolTip="平均每个汉字敲几个字母：全拼约 3 个，用简拼和词组会更少">
                            <TextBlock Text="每字按键" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Keys, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" ToolTipService.ToolTip="选中了 PinyinFlux 补充的云词的次数">
                            <TextBlock Text="用了云词" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Cloud, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Last 30 days -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="近 30 天" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ChartPeak, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Chart}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="30" ItemsStretch="Fill"
                                               MinItemWidth="4" MinItemHeight="120" MinColumnSpacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:TypingBar">
                                <Grid Height="120" Background="Transparent" ToolTipService.ToolTip="{x:Bind Detail}">
                                    <Border VerticalAlignment="Bottom" Height="{x:Bind Height}" CornerRadius="2" Opacity="{x:Bind Opacity}"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Grid>
                        <TextBlock Text="{x:Bind ViewModel.ChartStart, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ChartMiddle, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="今天" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- All time -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="累计" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalDays, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="上屏汉字" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalChars, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="打字时长" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalTime, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="平均速度" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalSpeed, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="2">
                            <TextBlock Text="日均" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DailyAverage, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.BestDayDate, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.BestDay, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                            <TextBlock Text="用了云词" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalCloud, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Settings -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <controls:SettingRow Header="记录打字统计"
                                         Description="数据保存在本机的 stats.csv。微软拼音不记录输入历史的场合（如隐私模式）不计数。">
                        <ToggleSwitch Style="{StaticResource TrailingSwitchStyle}" IsOn="{x:Bind Settings.TypingStats, Mode=TwoWay}" />
                    </controls:SettingRow>
                    <controls:SettingRow Header="清除统计" Description="删除所有日期的统计数据，无法恢复。">
                        <Button Content="清除">
                            <Button.Flyout>
                                <Flyout x:Name="ClearFlyout">
                                    <StackPanel Spacing="12" MaxWidth="260">
                                        <TextBlock Text="确定删除所有打字统计吗？" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Button Content="删除" Style="{StaticResource AccentButtonStyle}" Click="OnClear" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </controls:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
