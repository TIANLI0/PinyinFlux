<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PinyinFlux.App.Controls.SettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 settings row: text on the left, the control on the right. -->
    <Grid ColumnSpacing="16" MinHeight="36">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="HeaderText" TextWrapping="Wrap" />
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
        </StackPanel>
        <ContentPresenter x:Name="ActionPresenter" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>
</UserControl>
