<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3 settings app, unpackaged and Windows App SDK self-contained. Runs only while open;
       the resident part is the native PinyinFluxCore.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(PinyinFluxWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(PinyinFluxMinWindows)</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <RootNamespace>PinyinFlux.App</RootNamespace>
    <AssemblyName>PinyinFlux</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PinyinFlux.ico</ApplicationIcon>

    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Required so publish copies PinyinFlux.pri (compiled XAML). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <!-- Program.cs keeps the settings window single-instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Source-generated P/Invoke (LibraryImport). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- Only Chinese and English WinUI resources ship; native MUI files bypass SatelliteResourceLanguages. -->
  <Target Name="FilterWinUILocalizations" AfterTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb' and '$(CopyOutputSymbolsToPublishDirectory)' == 'false'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Extension)' == '.mui' and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^(?i:en-us|zh-cn)[\\/]'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <!-- Icons, the author photo and sponsor codes are loaded from Assets\ at run time. The .svg files are the icon sources. -->
    <Content Include="Assets\**\*.ico;Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The native core (src/PinyinFlux.Core, MSVC + CMake) ships next to the UI. build.ps1 at the
       repository root builds it; this target rebuilds it when its sources change. -->
  <PropertyGroup>
    <CoreRoot>$(MSBuildThisFileDirectory)..\..\</CoreRoot>
    <CoreExe>$(CoreRoot)out\core\Release\PinyinFluxCore.exe</CoreExe>
  </PropertyGroup>
  <Target Name="BuildCore" BeforeTargets="AssignTargetPaths" Condition="'$(RuntimeIdentifier)' == 'win-x64'"
          Inputs="@(CoreSource);$(CoreRoot)CMakeLists.txt;$(CoreRoot)build.ps1" Outputs="$(CoreExe);$(CoreRoot)out\core\Release\PinyinFluxInject.dll">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(CoreRoot)build.ps1&quot; -Config Release" />
  </Target>
  <Target Name="IncludeCore" AfterTargets="BuildCore" BeforeTargets="AssignTargetPaths">
    <ItemGroup Condition="Exists('$(CoreExe)')">
      <Content Include="$(CoreExe)" Link="PinyinFluxCore.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="$(CoreRoot)out\core\Release\PinyinFluxInject.dll" Link="PinyinFluxInject.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <CoreSource Include="..\PinyinFlux.Core\**\*.cpp;..\PinyinFlux.Core\**\*.h" />
    <CoreSource Include="..\PinyinFlux.Inject\**\*.cpp;..\PinyinFlux.Inject\**\*.h" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" />
  </ItemGroup>
</Project>
