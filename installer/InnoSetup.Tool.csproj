<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Restore-only helper: downloads the Inno Setup compiler (ISCC.exe) as a NuGet package so building
    the installer needs no system-wide installation.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <InnoSetupVersion>7.1.0</InnoSetupVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="Tools.InnoSetup" Version="[$(InnoSetupVersion)]" />
  </ItemGroup>
</Project>
